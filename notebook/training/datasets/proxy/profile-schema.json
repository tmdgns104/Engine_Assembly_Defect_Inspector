{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection Profile v1 / v2",
  "description": "Version 1 class removal remains unchanged. Version 2 records physical slots and expected counts. capture_proxy.validate_profile is normative for defined-class, slot/count and NORMAL consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_schema_version",
    "product_id",
    "profile_version",
    "objects",
    "scenarios"
  ],
  "properties": {
    "profile_schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "product_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "scenarios": {
      "type": "object"
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "slots"
          ]
        },
        "properties": {
          "scenarios": {
            "type": "object",
            "required": [
              "NORMAL"
            ],
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{0,31}$",
              "not": {
                "const": "CAMERA_SMOKE"
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "objects_removed",
                "unexpected_object"
              ],
              "properties": {
                "objects_removed": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "unexpected_object": {
                  "type": "boolean"
                }
              }
            },
            "properties": {
              "NORMAL": {
                "const": {
                  "objects_removed": [],
                  "unexpected_object": false
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "slots"
        ],
        "properties": {
          "scenarios": {
            "type": "object",
            "required": [
              "NORMAL"
            ],
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_-]{0,31}$",
              "not": {
                "const": "CAMERA_SMOKE"
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expected_counts",
                "removed_slots",
                "unexpected_object"
              ],
              "properties": {
                "expected_counts": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "removed_slots": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
                  }
                },
                "unexpected_object": {
                  "type": "boolean"
                }
              }
            },
            "properties": {
              "NORMAL": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_counts",
                  "removed_slots",
                  "unexpected_object"
                ],
                "properties": {
                  "expected_counts": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                    }
                  },
                  "removed_slots": {
                    "const": []
                  },
                  "unexpected_object": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
