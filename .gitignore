# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
.env

# Data / artifacts (avoid large binaries in Git)
data/raw/
data/processed/
data/proxy/raw/
data/engine/raw/
data/proxy/smoke/
training/outputs/
models/*.pt
models/*.onnx
models/*.engine
runs/
*.pt
*.cache
/datasets/
.cache/
/dist/engine_dataset_wizard/

# Generated baseline plots, predictions and checkpoints (metadata stays reviewable)
/training/experiments/*/baseline/
/training/experiments/*/b03_predictions/
/training/experiments/*/b03_validation/
/training/experiments/*/validation_predictions/
/training/experiments/*/error_review_*/
/training/experiments/*/roi_crop/
/training/scripts/_tmp_*.py

# Other exported model formats stay local, including future experiment folders.
*.onnx
*.engine
*.safetensors

# Runtime state
journal/*.db
*.log
*.token
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
/deployment/products/*/*/self_test.png

# Current device-separated layout: source in jetson/ and notebook/.
/archives/
/dist/
/runtime/
/runtime-data/
/.idea/
/Ultralytics/
/data/
/verification/
# Historical local source is retained for old evidence; Git history preserves it.
/apps/
/src/
/scripts/
/tests/
/training/
/deployment/
/config/
/models/
/recipes/
# Runtime data and binary assets travel in verified deployment bundles, not Git.
/notebook/data/
/notebook/logs/
/notebook/.venv/
/notebook/deployment/products/**/model.plan
/notebook/deployment/products/**/*.png
/notebook/deployment/products/**/*.npz
/jetson/config/area_references/
/notebook/deployment/*.tar.gz
/notebook/deployment/*.partial
*.plan
*.db
# Device-specific settings/credentials are not shared defaults.
/notebook/deployment/targets/
**/runtime.local.json
**/station.local.json
*.pem
*.key
